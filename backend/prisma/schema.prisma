generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// counsellor and registration access models

model RegistrationAccess {
  email      String      @id @unique
  privateKey String      @unique
  counsellor Counsellor?
}

model College {
  id         Int        @id @default(autoincrement())
  name       String
  sessionFee Int        @default(0)
  documents  Document[]
}

model Document {
  id              Int    @id @default(autoincrement())
  idCardUrl       String
  marksheetUrl    String
  profilePhotoUrl String
  collegeId       Int
  branchName      String

  college    College     @relation(fields: [collegeId], references: [id])
  counsellor Counsellor?
}

model Counsellor {
  id              Int              @id @default(autoincrement())
  name            String
  password        String?
  phone           String           @db.VarChar(10)
  email           String           @unique
  UPI             String?          @unique
  isVerified      Boolean          @default(false)
  documentId      Int?             @unique
  createdAt       DateTime         @default(now())
  sessionRequests SessionRequest[]

  // Chat relationships
  sentChats        Chat[]                   @relation("CounsellorSender")
  receivedChats    Chat[]                   @relation("CounsellorReceiver")
  payment          Payment[]
  counsellorAccess CousellorStudentAccess[]

  document           Document?          @relation(fields: [documentId], references: [id])
  registrationAccess RegistrationAccess @relation(fields: [email], references: [email])
}

// student models
model Student {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  phone           String           @db.VarChar(10)
  passwordHash    String
  createdAt       DateTime         @default(now())
  sessionRequests SessionRequest[]

  // Chat relationships
  sentChats        Chat[]                   @relation("StudentSender")
  receivedChats    Chat[]                   @relation("StudentReceiver")
  payments         Payment[]
  counsellorAccess CousellorStudentAccess[]
}

// session request models

model SessionRequest {
  id              Int      @id @default(autoincrement())
  studentId       Int
  counsellorId    Int
  chatSessionCode String   @unique
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  student          Student           @relation(fields: [studentId], references: [id])
  counsellor       Counsellor        @relation(fields: [counsellorId], references: [id])
  completedSession CompletedSession?
}

model CompletedSession {
  id               Int      @id @default(autoincrement())
  sessionRequestId Int      @unique
  startedAt        DateTime
  endedAt          DateTime
  studentFeedback  String?
  rating           Int?

  sessionRequest SessionRequest @relation(fields: [sessionRequestId], references: [id])
}

model Payment {
  id           Int        @id @default(autoincrement())
  counsellorId Int
  studentId    Int
  amount       Int
  orderID      String     @unique
  paymentDate  DateTime   @default(now())
  paymentID    String?    @unique
  signature    String?
  status       String     @default("pending")
  counsellor   Counsellor @relation(fields: [counsellorId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])
}

model CousellorStudentAccess {
  id           Int      @id @default(autoincrement())
  studentId    Int
  counsellorId Int
  orderID      String   @unique
  IsAllowed    String   @default("False")
  createdAt    DateTime @default(now())

  student    Student    @relation(fields: [studentId], references: [id])
  counsellor Counsellor @relation(fields: [counsellorId], references: [id])
}

model Chat {
  id        Int      @id @default(autoincrement())
  message   String   @db.Text
  createdAt DateTime @default(now())

  // Sender fields (only one will be used)
  studentSenderId    Int?
  counsellorSenderId Int?

  // Receiver fields (only one will be used)
  studentReceiverId    Int?
  counsellorReceiverId Int?

  // Use named relations for different sender/receiver types
  studentSender    Student?    @relation("StudentSender", fields: [studentSenderId], references: [id])
  counsellorSender Counsellor? @relation("CounsellorSender", fields: [counsellorSenderId], references: [id])

  studentReceiver    Student?    @relation("StudentReceiver", fields: [studentReceiverId], references: [id])
  counsellorReceiver Counsellor? @relation("CounsellorReceiver", fields: [counsellorReceiverId], references: [id])

  // Add an enum field to identify the message type
  senderType   String? // "STUDENT" or "COUNSELLOR"
  receiverType String? // "STUDENT" or "COUNSELLOR"

  @@index([studentSenderId])
  @@index([counsellorSenderId])
  @@index([studentReceiverId])
  @@index([counsellorReceiverId])
}

model Feedback {
  id                Int    @id @default(autoincrement())
  rating            Int    @default(2)
  counselorFeedback String
  sessionLink       String
  mostHelpful       String
  studentId         Int
  counsellorId      Int
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
